*.bak
*.backup
*.log
*.db
*.db-*
*.sqlite
*.sqlite3
*.lock
.cache/
cache/
logs/
sessions/
state/

# Sensitive home-directory trees (defense in depth)
/.ssh/
/.gnupg/
/.pki/
/.local/share/keyrings/
/.config/gh/
/.config/google-chrome/
/.config/chromium/
/.config/microsoft-edge/
/.config/mozilla/
/.config/opera/
/.config/expressvpn/
/.config/nordvpn/

