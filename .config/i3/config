exec --no-startup-id "i3-msg 'workspace 1; exec kitty'"

########################################################################
########################################################################
####
####                   Floated windows
####
########################################################################
########################################################################

for_window [title="Calculator"] floating enable, border normal 3
for_window [title="Timer"] floating enable, border normal 3
# Keep title bars on new windows, including floating dialogs and popups.
for_window [class="^.*"] border normal
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [window_type="dialog"] border normal 3
for_window [class="mpv"] floating enable, border normal 3
for_window [class="imv"] floating enable, border normal 3
for_window [class="zenity"] floating enable, border normal 3
for_window [class="cachyos-welcome"] floating enable, border normal 3


########################################################################
########################################################################
####
####                   HOTKEYS
####
########################################################################
########################################################################


bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
# mute sound
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

bindsym $mod+Shift+p exec gnome-calculator
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id ksnip -f
#bindsym $mod+p exec ~/.scripts/dmshot

# Display modes
# Win+F1: 2K display only
bindsym $mod+F1 exec --no-startup-id xrandr --output HDMI-0 --off --output DP-2 --primary --mode 2560x1440 --rate 164.96 --pos 0x0
# Win+F2: HDMI display on the left, 2K primary display on the right
bindsym $mod+F2 exec --no-startup-id xrandr --output HDMI-0 --mode 1920x1080 --rate 100 --pos 0x0 --output DP-2 --primary --mode 2560x1440 --rate 164.96 --pos 1920x0

## This will switch the current layout to the 'us'.
#bindsym $mod+l exec "setxkbmap -layout us && sleep 0.1 && setxkbmap -option grp:caps_toggle 'us,ru' -option grp_led:caps && sleep 0.1 && i3lock --blur 5"

## Lock the screen ($mod+l is used for focus up in default i3 navigation)
bindsym $mod+Ctrl+l exec "sleep 0.1 && i3lock --blur 5"

